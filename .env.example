# Real provider configuration for the NIV Elite AI Provider Protocol.
# Never commit an actual API key.
NIV_AI_BASE_URL=https://your-provider.example/
NIV_AI_PROVIDER_MODE=remote
NIV_AI_PROVIDER_ID=your-provider-id
NIV_AI_MODEL=your-music-model-id
NIV_AI_API_KEY=replace-at-runtime

# Optional safety and timeout controls.
NIV_AI_REQUEST_TIMEOUT_MS=120000
NIV_AI_JOB_TIMEOUT_MS=1800000
NIV_AI_MAX_ARTIFACT_BYTES=2147483648

# For a loopback model server, use for example:
# NIV_AI_BASE_URL=http://127.0.0.1:8080/
# NIV_AI_PROVIDER_MODE=local
# NIV_AI_LOCAL_ARTIFACT_ROOT=E:\\model-output
